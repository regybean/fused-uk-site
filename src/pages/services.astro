---
import Layout from "@/layouts/main.astro"
import { Image } from "astro:assets"
import ietCodeOfPractice from "@/assets/iet-code-of-practice-5th-edition.png"
import microwaveLeakage from "@/assets/microwave-leakage-test.jpg"
import cableRepairs from "@/assets/cable-repairs.jpg"
import assetCertifications from "@/assets/asset-certifications.jpg"
import renewalReminder from "@/assets/renewal-reminder.jpg"
import emergencyLight from "@/assets/emergency-light-test.jpg"
import TickList from "@/components/site/TickList.astro"
import Eyebrow from "@/components/site/Eyebrow.astro"
import CtaBand from "@/components/site/CtaBand.astro"

const services = [
  {
    n: "01",
    title: "Fully Inclusive PAT Testing",
    body: "Inspection and safety testing of portable appliances with the latest computerised equipment. Testing follows IEE Code of Practice standards. Minor repairs and replacement fuses/IT leads are provided at no charge.",
    image: ietCodeOfPractice,
    featured: true,
    placeholder: null,
  },
  {
    n: "02",
    title: "Cable Repairs",
    body: "The majority of items which fail a visual PAT testing inspection are due to damaged cable and flex. Heavily used items such as vacuums and 110v site equipment can all be damaged through general wear and tear. Replacement of cable/flex can be undertaken by Fused UK.",
    image: cableRepairs,
    featured: false,
    placeholder: null,
  },
  {
    n: "03",
    title: "Asset Reports and Certification",
    body: "To accompany your annual PAT test certificate, our engineers will produce a detailed electrical testing report that lists all the assets tested. This report will also help towards documenting your asset lists in case of audit/inspection. Customers are supplied with an itemised appliance register, Certificate of PAT testing and list of failed and passed items. Reports are provided free of charge in a bound folder (where appropriate) and can also be provided via pdf.",
    image: assetCertifications,
    featured: false,
    placeholder: null,
  },
  {
    n: "04",
    title: "Free Reminder Renewal Service",
    body: "Automatic contact system ensures certification renewal scheduling and prevents expiration.",
    image: renewalReminder,
    featured: false,
    placeholder: null,
  },
  {
    n: "05",
    title: "Microwave Leakage Testing",
    body: "Radiation intensity assessments are conducted, with reports detailing mW/cm2 output levels.",
    image: microwaveLeakage,
    featured: false,
    placeholder: null,
  },
  {
    n: "06",
    title: "Emergency Light Testing",
    body: "The company provides inspection and testing for 6-monthly and annual compliance periods. Services include verifying correct fixture placement and signage.",
    image: emergencyLight,
    featured: false,
    placeholder: null,
  },
]

const closing = [
  "No hidden charges on quotes",
  "DBS-checked engineers approved for schools, hospitals, and residences",
]
---

<Layout title="Services — FUSED UK PAT Testing">
  <section class="border-b">
    <div class="mx-auto max-w-[1200px] px-4 py-16 md:px-6 md:py-20">
      <Eyebrow>Services</Eyebrow>
      <h1 class="mt-3 text-center text-4xl font-semibold tracking-tight md:text-5xl">
        Services
      </h1>
      <TickList items={closing} class="mx-auto mt-10 max-w-2xl" />
    </div>
  </section>

  <div class="mx-auto max-w-[1200px] px-4 py-16 md:px-6 md:py-24">
    <div class="flex flex-col gap-20 md:gap-28">
      {
        services.map((s, idx) => (
          <article
            class:list={[
              "grid items-center gap-10 md:grid-cols-2 md:gap-16",
              s.featured && "border-primary border-l-4 pl-6 md:pl-10",
            ]}
          >
            <div
              class:list={[
                "order-2",
                idx % 2 === 1 ? "md:order-2" : "md:order-1",
              ]}
            >
              {s.featured ? (
                <div class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
                  Our core service
                </div>
              ) : (
                <div class="text-primary/40 font-mono text-sm font-semibold tracking-widest">
                  {s.n}
                </div>
              )}
              <h2 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">
                {s.title}
              </h2>
              <div class="bg-primary mt-4 h-1 w-12"></div>
              <p class="text-muted-foreground mt-6 text-base leading-relaxed">
                {s.body}
              </p>
            </div>
            <div
              class:list={[
                "order-1",
                idx % 2 === 1 ? "md:order-1" : "md:order-2",
              ]}
            >
              {s.image ? (
                <div class="aspect-[4/3] overflow-hidden bg-muted">
                  <Image
                    src={s.image}
                    alt={s.title}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
              ) : (
                <div class="aspect-[4/3] flex items-center justify-center overflow-hidden border border-dashed border-primary/30 bg-gradient-to-br from-primary/10 via-primary/5 to-transparent p-6 text-center">
                  <span class="text-primary/50 text-sm font-medium">
                    [{s.placeholder}]
                  </span>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <CtaBand />
</Layout>
