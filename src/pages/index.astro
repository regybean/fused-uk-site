---
import Layout from "@/layouts/main.astro"
import { Image } from "astro:assets"
import ietCodeOfPractice from "@/assets/iet-code-of-practice-5th-edition.png"
import dbsLight from "@/assets/disclosure-and-barring-service.png"
import dbsDark from "@/assets/disclosure-barring-service-dark.png"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { BookNowButton } from "@/components/site/BookNowButton"
import { HeroCarousel } from "@/components/site/HeroCarousel"
import { ReviewsCarousel } from "@/components/site/ReviewsCarousel"
import { GOOGLE_REVIEWS_URL } from "@/lib/contact"
import TickList from "@/components/site/TickList.astro"
import Eyebrow from "@/components/site/Eyebrow.astro"
import CtaBand from "@/components/site/CtaBand.astro"

const benefits = [
  "Beat any quotation",
  "Same-day callout and flexible after-hours/weekend testing",
  "DBS-checked engineers",
  "Testing per IEE Code of Practice",
  "Itemised asset reports",
  "No hidden charges",
]

const patHighlights = [
  "Latest computerised testing equipment",
  "Testing follows IEE Code of Practice standards",
  "Minor repairs and replacement fuses/IT leads at no charge",
]

const otherServices = [
  {
    title: "Microwave Leakage Testing",
    body: "Radiation intensity assessments with reports detailing mW/cm2 output levels.",
  },
  {
    title: "Emergency Light Testing",
    body: "Inspection and testing for 6-monthly and annual compliance periods.",
  },
]
---

<Layout>
  {/* 1. Hero carousel */}
  <section class="relative isolate overflow-hidden bg-neutral-950">
    <div class="absolute inset-0 -z-10">
      <HeroCarousel client:load />
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/55 to-black/75"></div>
    </div>

    <div class="mx-auto max-w-[1200px] px-4 py-20 text-center text-white md:px-6 md:py-32">
      <p class="text-primary text-xs font-semibold tracking-[0.25em] uppercase">
        PAT testing specialists
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-6xl">
        FUSED UK PAT Testing
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base text-white/85 md:text-lg">
        Welcome to FUSED UK. We provide specialist portable appliance testing
        (PAT testing) services that enable you to comply with health and safety,
        insurance and site survey regulations.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <BookNowButton client:load size="lg" className="text-sm" />
        <Button
          asChild
          client:load
          size="lg"
          variant="outline"
          className="border-white/30 bg-transparent text-sm text-white hover:bg-white/10 hover:text-white"
        >
          <a href="/quote">Get a Quote</a>
        </Button>
      </div>

      <p class="mt-8 text-sm leading-relaxed text-white/75">
        We aim to 'beat any quote', so if you require electrical testing
        services, please don't hesitate to call us on
        <a
          href="tel:07729577307"
          class="text-primary font-semibold hover:underline"
        >
          07729 577307
        </a>.
      </p>
    </div>
  </section>

  {/* 2. Key benefits strip */}
  <section class="border-y bg-muted/30">
    <div class="mx-auto max-w-[1200px] px-4 py-10 md:px-6 md:py-14">
      <TickList
        items={benefits}
        class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3"
      />
    </div>
  </section>

  {/* 3. Services preview — Fully Inclusive PAT featured */}
  <section class="mx-auto max-w-[1200px] px-4 py-16 md:px-6 md:py-24">
    <Eyebrow>What we do</Eyebrow>
    <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight md:text-4xl">
      Services
    </h2>

    {/* Featured: Fully Inclusive PAT Testing */}
    <Card className="mt-12 overflow-hidden border-t-4 border-t-primary pt-0 pb-0">
      <div class="grid md:grid-cols-2">
        <div class="aspect-[4/3] overflow-hidden bg-muted md:aspect-auto">
          <Image
            src={ietCodeOfPractice}
            alt="In-service Inspection and Testing of Electrical Equipment — IET Code of Practice"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <CardContent className="flex flex-col justify-center gap-5 p-8 md:p-10">
          <div>
            <span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
              Our core service
            </span>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">
              Fully Inclusive PAT Testing
            </h3>
          </div>
          <p class="text-muted-foreground text-base leading-relaxed">
            Inspection and safety testing of portable appliances with the
            latest computerised equipment, carried out to IEE Code of Practice
            standards.
          </p>
          <TickList items={patHighlights} />
          <div>
            <a
              href="/services"
              class="text-primary hover:text-primary/80 inline-flex items-center gap-1 text-sm font-semibold"
            >
              See all services
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </CardContent>
      </div>
    </Card>

    {/* Secondary services — de-emphasised */}
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        otherServices.map((s) => (
          <Card className="bg-muted/30 h-full">
            <CardHeader>
              <CardTitle className="text-base">{s.title}</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {s.body}
              </p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </section>

  {/* 6. Reviews carousel */}
  <section class="bg-muted/30 border-y">
    <div class="mx-auto max-w-[1200px] px-4 py-16 md:px-6 md:py-24">
      <Eyebrow>Reviews</Eyebrow>
      <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight md:text-4xl">
        What our clients say
      </h2>
      <div class="mt-12">
        <ReviewsCarousel client:visible />
      </div>
      <div class="mt-10 text-center">
        <a
          href={GOOGLE_REVIEWS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:text-primary/80 inline-flex items-center gap-1 text-sm font-semibold"
        >
          Read more reviews on Google
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* 7. Trust strip */}
  <section class="border-b">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center justify-center gap-6 px-4 py-10 sm:flex-row sm:gap-10 md:px-6">
      <Image
        src={dbsLight}
        alt="Disclosure and Barring Service"
        loading="lazy"
        class="h-14 w-auto md:h-16 dark:hidden"
      />
      <Image
        src={dbsDark}
        alt="Disclosure and Barring Service"
        loading="lazy"
        class="hidden h-14 w-auto md:h-16 dark:block"
      />
      <p class="text-base font-semibold">Engineers are fully checked</p>
    </div>
  </section>

  {/* 8. Final CTA band */}
  <CtaBand />
</Layout>
