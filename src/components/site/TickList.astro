---
interface Props {
  items: string[]
  class?: string
  variant?: "tick" | "brand"
}
const { items, class: className } = Astro.props
---

<ul class:list={["space-y-2.5", className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-3 text-sm leading-relaxed sm:text-base">
        <span class="text-primary mt-0.5 shrink-0">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
